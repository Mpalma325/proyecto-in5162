# Copiar como .env en la raíz del proyecto y completar.
# El .env real nunca se sube: contiene credenciales.

# API de OpenAI
OPENAI_API_KEY=sk-...

# Cuenta de correo del curso.
# El app password se genera en myaccount.google.com/apppasswords y requiere
# tener 2FA activado. Google lo muestra en grupos de cuatro; esos espacios NO
# son parte de la clave (pegarlo con espacios es la causa típica de
# "Invalid credentials").
CORREO_REMITENTE=in5162@uchile.cl
CORREO_APP_PASSWORD=xxxxxxxxxxxxxxxx

# El curso. Llenan las marcas «CURSO», «NOMBRE_CURSO» y «PROFESOR» de la plantilla
# al crear un semestre (prompts y firma de los correos).
# Código como lo ven los alumnos en el asunto; sin él, IN5162.
# CURSO=IN5162
# Nombre del curso, en los prompts de corrección y tutoría.
NOMBRE_CURSO=Nombre del curso
# Quién firma los correos, junto al equipo docente.
PROFESOR=Nombre del profesor o profesora

# Sitio web (Cloudflare). Los usan web/scripts/acceso.mjs y modulos.web.
# Dirección del sitio publicado; acceso.mjs no corre sin ella.
WEB_URL=https://<curso>.<subdominio>.workers.dev
# Token de la API de Cloudflare (Workers, D1, R2 y Access); acceso.mjs no corre sin él.
CLOUDFLARE_API_TOKEN=
# Account ID; sin él, acceso.mjs usa la única cuenta que alcanza el token.
CLOUDFLARE_ACCOUNT_ID=

# --- opcionales, con estos valores por defecto ---
# MODELO=gpt-5.4-mini
# TEMPERATURA=0.2
# MAX_TOKENS=3000

# Tests semanales: dos grupos con preguntas distintas
# GRUPO_CONTROL_TRATAMIENTO=true
# GRUPO_SEED=19

# Tareas
# TAREA_DEFAULT=T1
# NOTA_MIN=4.0
# NOTA_MAX=7.0
# INCLUIR_CONTEXTO_CLASES=true

# Servidores de correo. Vienen apuntando a Gmail; cambiarlos permite correr
# sobre otro proveedor sin tocar código.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# Dominio de los Message-ID que se generan al enviar. No necesita existir.
# MSGID_DOMINIO=in5162.local

# Semestre sobre el que trabajar, solo para este proceso. Le gana al
# semestres/activo.txt y no lo modifica; sirve para mirar un semestre viejo
# sin cambiar el que opera los envíos:
#     IN5162_SEMESTRE=2026-1 python -m modulos.tests.resumen 3
