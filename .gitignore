# Secrets
.env

# Claude Code
.claude/

# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
env/
.venv/

# Runtime data
.message_ids.json

# Datos de cada semestre real: todo lo que cuelga de semestres/<id>/ es
# potencialmente sensible (alumnos, correos, notas, entregas, y cualquier
# archivo de análisis suelto que se haya generado ahí). Se ignora la carpeta
# completa; la única que se versiona es la plantilla _template.
semestres/*/
!semestres/_template/
semestres/activo.txt

# Los semestres se intercambian entre equipos como archivo comprimido, y ahí
# viajan los mismos nombres, correos y respuestas que la carpeta original. La
# regla de arriba no los cubre: solo tapa directorios, así que un .zip suelto
# aparecía como archivo nuevo listo para subir.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Y cualquier archivo suelto dentro de semestres/ que no sea el activo: ahí
# caen los export de análisis y los CSV que uno deja "un momento" al lado de
# las carpetas.
semestres/*.csv
semestres/*.json
semestres/*.xlsx

# Copias de una carpeta de semestre que se dejan aparte antes de reemplazarla.
# Tienen el mismo contenido sensible que el original, y viven fuera de
# semestres/ porque todo lo que cuelga de ahi la app lo lista como un semestre.
respaldos/

# Carpetas de entrega puntual (deliverables para el profesor, no parte del código)
subir/
anexo/

# Artefactos generados a partir del README (se regeneran con pandoc)
README_IN5162.pdf
README_IN5162.docx

# OS / IDE
.DS_Store
Thumbs.db
.vscode/

# Salida de depuración de playwright-cli (capturas y consola locales).
.playwright-cli/
